{
  "name": "aris-app",
  "version": "0.5.85",
  "description": "Aris web dashboard",
  "private": true,
  "bin": {
    "aris": "./cli/cli.js",
    "9router": "./cli/cli.js"
  },
  "scripts": {
    "aris": "node cli/cli.js",
    "update": "node cli/cli.js update",
    "start:aris": "PORT=20128 node cli/app/custom-server.js",
    "build:cli": "node cli/scripts/build-cli.js",
    "dev": "next dev --port 20127",
    "dev:webpack": "next dev --webpack --port 20127",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "node custom-server.js --port 20127",
    "dev:bun": "bun --bun next dev --webpack --port 20127",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.4.6",
    "@node-saml/node-saml": "^5.2.0",
    "@xyflow/react": "^13.0.2",
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.1",
    "confbox": "^0.3.2",
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.2",
    "jose": "^6.2.18",
    "marked": "^18.2.1",
    "material-symbols": "^0.49.0",
    "monaco-editor": "^0.55.1",
    "next": "^16.4.6",
    "node-forge": "^1.4.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "ora": "^10.0.0",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.11.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^10.1.0",
    "sql.js": "^1.17.0",
    "undici": "^8.13.0",
    "uuid": "^14.0.3",
    "zustand": "^5.1.0"
  },
  "optionalDependencies": {
    "@aws-sdk/credential-providers": "^3.1135.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.2.0",
    "ws": "^8.18.0"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4",
    "wreq-js": "^3.2.0"
  },
  "overrides": {
    "dompurify": "^3.4.18"
  }
}
